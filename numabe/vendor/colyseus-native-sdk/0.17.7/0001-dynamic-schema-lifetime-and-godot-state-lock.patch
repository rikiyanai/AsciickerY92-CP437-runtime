+#ifdef _WIN32
+#include <windows.h>
+typedef CRITICAL_SECTION room_state_mutex_t;
+static room_state_mutex_t* room_state_mutex_create(void) {
+    room_state_mutex_t* mutex = malloc(sizeof(*mutex));
+    if (mutex) InitializeCriticalSection(mutex);
+    return mutex;
+}
+static void room_state_mutex_destroy(room_state_mutex_t* mutex) {
+    if (!mutex) return;
+    DeleteCriticalSection(mutex);
+    free(mutex);
+}
+static void room_state_mutex_lock(room_state_mutex_t* mutex) { EnterCriticalSection(mutex); }
+static void room_state_mutex_unlock(room_state_mutex_t* mutex) { LeaveCriticalSection(mutex); }
+#else
+#include <pthread.h>
+typedef pthread_mutex_t room_state_mutex_t;
+static room_state_mutex_t* room_state_mutex_create(void) {
+    room_state_mutex_t* mutex = malloc(sizeof(*mutex));
+    if (!mutex) return NULL;
+    pthread_mutexattr_t attributes;
+    if (pthread_mutexattr_init(&attributes) != 0) { free(mutex); return NULL; }
+    if (pthread_mutexattr_settype(&attributes, PTHREAD_MUTEX_RECURSIVE) != 0 ||
+        pthread_mutex_init(mutex, &attributes) != 0) {
+        pthread_mutexattr_destroy(&attributes);
+        free(mutex);
+        return NULL;
+    }
+    pthread_mutexattr_destroy(&attributes);
+    return mutex;
+}
+static void room_state_mutex_destroy(room_state_mutex_t* mutex) {
+    if (!mutex) return;
+    pthread_mutex_destroy(mutex);
+    free(mutex);
+}
+static void room_state_mutex_lock(room_state_mutex_t* mutex) { pthread_mutex_lock(mutex); }
+static void room_state_mutex_unlock(room_state_mutex_t* mutex) { pthread_mutex_unlock(mutex); }
