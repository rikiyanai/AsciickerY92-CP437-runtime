  "phase1_extractable_rules": [
    {
      "rule_id": "ota.rm.named_route_is_ota_managed",
      "input": "RM route-name presence",
      "output": "ota_managed",
      "strength": "official_management_classification",
      "site_truth_effect": "classification_constraint_only"
    },
    {
      "rule_id": "ota.rm.unnamed_route_is_not_ota_managed",
      "input": "RM route-name absence",
      "output": "not_ota_managed",
      "strength": "negative_ota_management_classification_only",
      "site_truth_effect": "classification_constraint_only"
    },
    {
      "rule_id": "ota.gh.width_is_survey_time_current_condition",
      "input": "GH width label",
      "output": "survey_time_current_condition_width_observation",
      "strength": "reference_observation",
      "site_truth_effect": "classification_constraint_only"
    },
    {
      "rule_id": "ota.gh.structure_position_is_reference_observation",
      "input": "GH side-gutter or structure position",
      "output": "observed_structure_carrier_candidate",
      "strength": "reference_observation",
      "site_truth_effect": "classification_constraint_only"
    },
    {
      "rule_id": "ota.kk_cs.boundary_state_is_evidence_not_geometry",
      "input": "KK or CS confirmation state",
      "output": "boundary_evidence_state",
      "strength": "constraint_only",
      "site_truth_effect": "classification_constraint_only"
    },
    {
      "rule_id": "ota.kj.control_point_declares_reference_system",
      "input": "KJ point metadata",
      "output": "coordinate_reference_and_manager",
      "strength": "official_control_metadata",
      "site_truth_effect": "classification_constraint_only"
    }
  ],
  "prohibited_inferences": [
    "Do not treat the background map as a road area or land boundary.",
    "Do not treat GH current-condition width as certified, recognized, or management width.",
    "Do not infer Building Standards Act Article 42 road status from Doro Map Ota.",
    "Do not infer the authority that manages a road merely from not_ota_managed.",
    "Do not infer a speed limit, sign type, sign location, gutter ratio, sidewalk type, or rail fence from these layers.",
    "Do not treat portal geometry as exact current physical geometry.",
    "Do not retain, edit, process, or reproduce municipal map drawings or tiles in a build artifact."
  ],
  "required_external_joins": [
    {
      "claim": "Building Standards Act road category",
      "source": "Machimap Ota building-code road map or competent-office confirmation"
    },
    {
      "claim": "recognized or management width",
      "source": "competent Ota office or another currently active official source"
    },
    {
      "claim": "traffic sign and marking family",
      "source": "national road-sign order plus observed physical instance"
    },
    {
      "claim": "current physical object existence and position",
      "source": "dated imagery, field survey, or accepted physical registration"
    }
  ],
  "source_reviewed_on": "2026-09-16"
}
