# ==============================================================================
# Sprite validation binary for CI (TEST-05)
# Phase 29: C++ Test Harness - standalone .xp file validator
# ==============================================================================
VALIDATE_BIN := .run/sprite_validate
VALIDATE_OBJDIR := .o_validate

# Compile tinfl.c as C, sprite_validate.cpp as C++, then link
$(VALIDATE_OBJDIR)/tinfl.o: engine/tinfl.c
	@mkdir -p $(VALIDATE_OBJDIR)
	$(CC) -O2 -c -o $@ $<

$(VALIDATE_OBJDIR)/sprite_validate.o: engine/sprite_validate.cpp engine/sprite_constants.h
	@mkdir -p $(VALIDATE_OBJDIR)
	$(CXX) $(CXXFLAGS) -O2 -c -o $@ $<

$(VALIDATE_BIN): $(VALIDATE_OBJDIR)/sprite_validate.o $(VALIDATE_OBJDIR)/tinfl.o
	@mkdir -p .run
	$(CXX) -O2 -o $@ $^
	@echo "Built: $@"

.PHONY: test_sprite
test_sprite: $(VALIDATE_BIN)
	@echo "sprite_validate ready at $(VALIDATE_BIN)"

