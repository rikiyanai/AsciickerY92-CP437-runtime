	@mkdir -p $(dir $(BIN))
	@$(LINK.o) $^ $(LDLIBS)

$(OBJDIR)/%.o: %.c
$(OBJDIR)/%.o: %.c $(DEPDIR)/%.d
	@echo Comiling $<
	@$(PRECOMPILE)
	@$(COMPILE.c) $<
	@$(POSTCOMPILE)

$(OBJDIR)/%.o: %.cpp
$(OBJDIR)/%.o: %.cpp $(DEPDIR)/%.d
	@echo Comiling $<
	@$(PRECOMPILE)
	@$(COMPILE.cc) $<
